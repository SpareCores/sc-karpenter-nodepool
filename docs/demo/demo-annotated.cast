[154.071, "o", "> apiVersion: apps/v1\r\n"]
[154.083, "o", "> kind: Deployment\r\n"]
[154.095, "o", "> metadata:\r\n"]
[154.107, "o", ">   name: gilty-sparecores\r\n"]
[154.119, "o", "> spec:\r\n"]
[154.131, "o", ">   selector: {matchLabels: {app: gilty, pool: gilty}}\r\n"]
[154.143, "o", ">   template:\r\n"]
[154.155, "o", ">     metadata: {labels: {app: gilty, pool: gilty}}\r\n"]
[154.167, "o", ">     spec:\r\n"]
[154.179, "o", ">       nodeSelector: {karpenter.sh/nodepool: gilty}\r\n"]
[154.191, "o", ">       serviceAccountName: gilty      # may read its node: the instance type\r\n"]
[154.203, "o", ">       containers:\r\n"]
