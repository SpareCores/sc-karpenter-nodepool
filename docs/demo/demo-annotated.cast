[60.161, "o", "\u001b[2J\u001b[3J\u001b[H"]
[60.161, "m", "GILty on a hand-picked instance"]
[60.211, "o", "\u001b[2;3;36m# GILty is a Python app held back by the GIL: it learns Moby-Dick as a Markov chain and babbles in its\u001b[0m\r\n"]
[60.261, "o", "\u001b[2;3;36m# style, one dependent hash lookup after the other, so only a faster core and cache make it faster. The\u001b[0m\r\n"]
[60.311, "o", "\u001b[2;3;36m# team picked r5a.large for it by hand (\"memory-optimized, for Python\"): a plain Karpenter NodePool\u001b[0m\r\n"]
[60.361, "o", "\u001b[2;3;36m# pinned to that type.\u001b[0m\r\n"]
[60.461, "o", "\u001b[1;32m$\u001b[0m "]
