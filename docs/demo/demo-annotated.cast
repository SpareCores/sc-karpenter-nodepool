[62.889, "o", "\r\n"]
[63.501, "o", "> apiVersion: karpenter.sh/v1\r\n"]
[63.513, "o", "> kind: NodePool\r\n"]
[63.525, "o", "> metadata:\r\n"]
[63.537, "o", ">   name: python-apps\r\n"]
[63.549, "o", "> spec:\r\n"]
[63.561, "o", ">   template:\r\n"]
[63.573, "o", ">     spec:\r\n"]
[63.585, "o", ">       nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[63.597, "o", ">       requirements:\r\n"]
[63.609, "o", ">         - {key: node.kubernetes.io/instance-type, operator: In, values: [r5a.large]}\r\n"]
[63.621, "o", ">         - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[63.633, "o", "> ---\r\n"]
[63.645, "o", "> apiVersion: apps/v1\r\n"]
[63.657, "o", "> kind: Deployment\r\n"]
[63.669, "o", "> metadata:\r\n"]
[63.681, "o", ">   name: gilty-handpicked\r\n"]
[63.693, "o", "> spec:\r\n"]
[63.705, "o", ">   selector: {matchLabels: {app: gilty, pool: python-apps}}\r\n"]
[63.717, "o", ">   template:\r\n"]
[63.729, "o", ">     metadata: {labels: {app: gilty, pool: python-apps}}\r\n"]
[63.741, "o", ">     spec:\r\n"]
[63.753, "o", ">       nodeSelector: {karpenter.sh/nodepool: python-apps}\r\n"]
