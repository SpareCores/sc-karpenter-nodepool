[60.219, "o", "\u001b[2J\u001b[3J\u001b[H"]
[60.219, "m", "GILty on a hand-picked instance"]
[60.269, "o", "\u001b[2;3;36m# GILty is a Python app held back by the GIL: it learns Moby-Dick as a Markov chain and babbles in its\u001b[0m\r\n"]
[60.319, "o", "\u001b[2;3;36m# style, one dependent hash lookup after the other, so only a faster core and cache make it faster. The\u001b[0m\r\n"]
[60.369, "o", "\u001b[2;3;36m# team picked r5a.large for it by hand (\"memory-optimized, for Python\"): a plain Karpenter NodePool\u001b[0m\r\n"]
[60.419, "o", "\u001b[2;3;36m# pinned to that type.\u001b[0m\r\n"]
[60.519, "o", "\u001b[1;32m$\u001b[0m "]
[60.899, "o", "k"]
[60.972, "o", "u"]
[61.009, "o", "b"]
[61.072, "o", "e"]
[61.164, "o", "c"]
[61.214, "o", "t"]
[61.279, "o", "l"]
[61.389, "o", " "]
[61.474, "o", "a"]
[61.545, "o", "p"]
[61.599, "o", "p"]
[61.681, "o", "l"]
[61.728, "o", "y"]
[61.783, "o", " "]
[61.851, "o", "-"]
[61.945, "o", "f"]
[62.06, "o", " "]
[62.101, "o", "-"]
