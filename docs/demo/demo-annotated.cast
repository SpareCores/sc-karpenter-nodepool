[113.476, "o", "\u001b[2J\u001b[3J\u001b[H"]
[113.476, "m", "Let Spare Cores pick"]
[113.526, "o", "\u001b[2;3;36m# Same size, same budget, measured data: at least the r5a.large's 2 vCPUs and 16 GiB, for at most 10%\u001b[0m\r\n"]
[113.576, "o", "\u001b[2;3;36m# more ($0.1392/h, Auto Mode fee included); instance families ranked by PassMark's single-threaded\u001b[0m\r\n"]
[113.626, "o", "\u001b[2;3;36m# score, the benchmark that tracks GILty best, keeping those within 10% of the fastest. No Karpenter\u001b[0m\r\n"]
[113.676, "o", "\u001b[2;3;36m# label can say any of this.\u001b[0m\r\n"]
[113.776, "o", "\u001b[1;32m$\u001b[0m "]
