[0.05, "o", "\u001b[2;3;36m# An EKS Auto Mode cluster: Auto Mode runs Karpenter for us. Only its built-in NodePools exist; the\u001b[0m\r\n"]
[0.1, "o", "\u001b[2;3;36m# system pool's nodes run the cluster add-ons.\u001b[0m\r\n"]
