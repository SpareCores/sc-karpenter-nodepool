[62.478, "o", "E"]
[62.531, "o", "O"]
[62.588, "o", "F"]
[62.635, "o", "'"]
[62.946, "o", "\r\n"]
[63.558, "o", "> apiVersion: karpenter.sh/v1\r\n"]
[63.57, "o", "> kind: NodePool\r\n"]
[63.582, "o", "> metadata:\r\n"]
[63.594, "o", ">   name: python-apps\r\n"]
[63.606, "o", "> spec:\r\n"]
[63.618, "o", ">   template:\r\n"]
[63.63, "o", ">     spec:\r\n"]
[63.642, "o", ">       nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[63.654, "o", ">       requirements:\r\n"]
[63.666, "o", ">         - {key: node.kubernetes.io/instance-type, operator: In, values: [r5a.large]}\r\n"]
[63.678, "o", ">         - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[63.69, "o", "> ---\r\n"]
[63.702, "o", "> apiVersion: apps/v1\r\n"]
[63.714, "o", "> kind: Deployment\r\n"]
[63.726, "o", "> metadata:\r\n"]
[63.738, "o", ">   name: gilty-handpicked\r\n"]
[63.75, "o", "> spec:\r\n"]
[63.762, "o", ">   selector: {matchLabels: {app: gilty, pool: python-apps}}\r\n"]
[63.774, "o", ">   template:\r\n"]
[63.786, "o", ">     metadata: {labels: {app: gilty, pool: python-apps}}\r\n"]
[63.798, "o", ">     spec:\r\n"]
[63.81, "o", ">       nodeSelector: {karpenter.sh/nodepool: python-apps}\r\n"]
[63.822, "o", ">       serviceAccountName: gilty      # may read its node: the instance type\r\n"]
[63.834, "o", ">       containers:\r\n"]
[63.846, "o", ">         - name: gilty\r\n"]
