[117.519, "o", "> apiVersion: karpenter.sparecores.com/v1alpha1\r\n"]
[117.531, "o", "> kind: SCNodePool\r\n"]
[117.543, "o", "> metadata:\r\n"]
[117.555, "o", ">   name: gilty\r\n"]
[117.567, "o", "> spec:\r\n"]
[117.579, "o", ">   nodePoolTemplate:\r\n"]
[117.591, "o", ">     spec:\r\n"]
[117.603, "o", ">       template:\r\n"]
[117.615, "o", ">         spec:\r\n"]
[117.627, "o", ">           nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[117.639, "o", ">           requirements:\r\n"]
[117.651, "o", ">             - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[117.663, "o", ">   selector:\r\n"]
[117.675, "o", ">     vcpus: {min: 2}                        # at least what the r5a.large has:\r\n"]
[117.687, "o", ">     memory: {minGiB: 16}                   #   2 vCPUs, 16 GiB\r\n"]
[117.699, "o", ">     price: {maxHourly: \"0.1392\"}           # r5a.large + 10%, Auto Mode fee included\r\n"]
[117.711, "o", ">     families: {exclude: [\"t*\", \"*-flex\"]}  # no burstable or flex: GILty needs a full core\r\n"]
[117.723, "o", ">   ranking:\r\n"]
[117.735, "o", ">     score:\r\n"]
[117.747, "o", ">       benchmark: {id: \"passmark:cpu_single_threaded_test\"}  # tracks GILty's speed best\r\n"]
[117.759, "o", ">     objective: Score              # fastest first; the price cap keeps the budget\r\n"]
[117.771, "o", ">     band: {withinPercent: 10}     # within 10% of the fastest counts as equal: cheapest wins\r\n"]
[117.783, "o", ">     families: {min: 1, max: 3}    # keep 1 to 3 such families; never pad with slower ones\r\n"]
[117.795, "o", "> EOF\r\n"]
[118.795, "o", "scnodepool.karpenter.sparecores.com/gilty created\r\n"]
