[59.951, "o", "> apiVersion: karpenter.sh/v1\r\n"]
[59.963, "o", "> kind: NodePool\r\n"]
[59.975, "o", "> metadata:\r\n"]
[59.987, "o", ">   name: python-apps\r\n"]
[59.999, "o", "> spec:\r\n"]
[60.011, "o", ">   template:\r\n"]
[60.023, "o", ">     spec:\r\n"]
[60.035, "o", ">       nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[60.047, "o", ">       requirements:\r\n"]
[60.059, "o", ">         - {key: node.kubernetes.io/instance-type, operator: In, values: [r5a.large]}\r\n"]
[60.071, "o", ">         - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[60.083, "o", "> ---\r\n"]
[60.095, "o", "> apiVersion: apps/v1\r\n"]
[60.107, "o", "> kind: Deployment\r\n"]
[60.119, "o", "> metadata:\r\n"]
[60.131, "o", ">   name: gilty-handpicked\r\n"]
