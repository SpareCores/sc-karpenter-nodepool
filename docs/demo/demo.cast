[60.215, "o", ">       containers:\r\n"]
[60.227, "o", ">         - name: gilty\r\n"]
[60.239, "o", ">           image: ghcr.io/sparecores/gilty:0.1.0\r\n"]
[60.251, "o", ">           args: [--interval, \"5\"]\r\n"]
[60.263, "o", ">           resources: {requests: {cpu: \"1\", memory: 512Mi}}\r\n"]
