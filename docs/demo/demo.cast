[46.351, "o", "Pulled: ghcr.io/sparecores/charts/sc-karpenter-nodepool:0.1.1\r\nDigest: sha256:c91c8450bd073ab27e1336a429dc4aba2158f32a885a5ee541b6529cc5549d63\r\n"]
[47.351, "o", "NAME: sc-karpenter-nodepool\r\nLAST DEPLOYED: Wed Oct 14 09:48:58 2026\r\nNAMESPACE: \u001b[36msc-karpenter-nodepool\u001b[0m\r\nSTATUS: \u001b[32mdeployed\u001b[0m\r\nREVISION: 1\r\n"]
[47.351, "o", "DESCRIPTION: Install complete\r\nTEST SUITE: None\r\nNOTES:\r\nsc-karpenter-nodepool 0.1.1 is installed in the namespace sc-karpenter-nodepool.\r\n\r\nCreate an SCNodePool to get a Karpenter NodePool with a benchmark-driven\r\ninstance-type list, for example:\r\n\r\n  kubectl apply -f https://raw.githubusercontent.com/SpareCores/sc-karpenter-nodepool/main/config/samples/karpenter_v1alpha1_scnodepool_minimal.yaml\r\n  kubectl get scnodepools\r\n\r\nCheck the controller:\r\n\r\n  kubectl -n sc-karpenter-nodepool rollout status deployment/sc-karpenter-nodepool\r\n  kubectl -n sc-karpenter-nodepool logs deployment/sc-karpenter-nodepool\r\n"]
