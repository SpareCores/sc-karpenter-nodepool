{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "replicaCount": {"type": "integer", "minimum": 0},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/labels"},
        "automount": {"type": "boolean"}
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "keeper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "timeout": {"$ref": "#/definitions/duration"},
        "regionsPerRequest": {"type": "integer", "minimum": -1},
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "dataCacheTTL": {"$ref": "#/definitions/duration"},
    "maxConcurrentReconciles": {"type": "integer", "minimum": 1},
    "nodeClassDiscoveryInterval": {"$ref": "#/definitions/duration"},
    "awsPriceListURL": {"type": "string", "pattern": "^https?://"},
    "nodeClassRefOverride": {"type": "string", "pattern": "^([^/]*/[^/]+/[^/]+)?$"},
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"type": ["string", "integer"]},
        "encoder": {"enum": ["json", "console"]},
        "development": {"type": "boolean"},
        "stacktraceLevel": {"enum": ["info", "error", "panic"]},
        "timeEncoding": {"enum": ["epoch", "millis", "nano", "iso8601", "rfc3339", "rfc3339nano"]}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"port": {"$ref": "#/definitions/port"}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"$ref": "#/definitions/port"},
        "secure": {"type": "boolean"},
        "enableHTTP2": {"type": "boolean"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {"$ref": "#/definitions/labels"}
          }
        },
        "readers": {"type": "array", "items": {"type": "object"}}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string"},
        "interval": {"$ref": "#/definitions/duration"},
        "scrapeTimeout": {"type": "string"},
        "labels": {"$ref": "#/definitions/labels"},
        "insecureSkipVerify": {"type": "boolean"}
      }
    },
    "extraArgs": {"type": "array", "items": {"type": "string"}},
    "extraEnv": {"type": "array", "items": {"type": "object"}},
    "extraVolumes": {"type": "array", "items": {"type": "object"}},
    "extraVolumeMounts": {"type": "array", "items": {"type": "object"}},
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "nodeClassGroups": {"type": "array", "items": {"type": "string"}},
        "userRoles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"create": {"type": "boolean"}}
        },
        "extraRules": {"type": "array", "items": {"type": "object"}}
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {"type": "boolean"},
        "keep": {"type": "boolean"}
      }
    },
    "podAnnotations": {"$ref": "#/definitions/labels"},
    "podLabels": {"$ref": "#/definitions/labels"},
    "deploymentAnnotations": {"$ref": "#/definitions/labels"},
    "priorityClassName": {"type": "string"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "affinity": {"type": "object"},
    "nodeSelector": {"$ref": "#/definitions/labels"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    }
  }
}
